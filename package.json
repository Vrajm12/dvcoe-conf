{
  "name": "conference-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:login": "cloudflared tunnel login",
    "start:watch": "nodemon --watch app --watch public --ext tsx,ts,js,json --exec \"npm run build && npm run start\" --delay 1000",
    "start:pm2": "pm2 start npm --name dvcoe -- run start --watch"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "framer-motion": "^11.0.0",
    "gray-matter": "^4.0.3",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "nodemon": "^2.0.22",
    "pm2": "^5.2.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
